# Copy to .env and fill in. Used by `make upload` to push DMG releases to a
# DigitalOcean Spaces bucket (S3-compatible) for the website to download from.
#
# `.env` is gitignored — don't commit your real credentials.

# The S3-compatible bucket name (the DO Space).
S3_BUCKET=macaveli

# Public CDN base URL — what the website links to.
# Format: https://<bucket>.<region>.cdn.digitaloceanspaces.com
S3_CDN_URL=https://macaveli.sfo3.cdn.digitaloceanspaces.com

# Upload endpoint — region endpoint, NOT the bucket-specific URL.
# Format: https://<region>.digitaloceanspaces.com
S3_UPLOAD_ENDPOINT=https://sfo3.digitaloceanspaces.com

# DO Spaces accepts any AWS region for SigV4 signing. us-east-1 is fine.
AWS_REGION=us-east-1

# Spaces access key (DigitalOcean → API → Spaces access keys).
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
